Meta.DisplayName=Tears of the Kingdom Online Multiplayer Server
Meta.Description=Dedicated Tears of the Kingdom Online Multiplayer server from the official Java release
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=firefloc
Meta.URL=https://hub.docker.com/r/wesleyhellewell/totk_online_multiplayer_server_test
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/firefloc/amptemplates/main/totk-online-multiplayer-server.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=totk-online-multiplayer-serverconfig.json
Meta.MetaConfigManifest=totk-online-multiplayer-servermetaconfig.json
Meta.ConfigRoot=totk-online-multiplayer-server.kvp
Meta.MinAMPVersion=2.5.0.12
Meta.SpecificDockerImage=cubecoders/ampbase:java-lts
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=5
Meta.ReleaseNotes=Uses the official AMP Java base image and downloads Temurin Java 25 into each instance. No custom Docker server image is used.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=d3ca0b79-3c81-49e6-a21d-e3c0d9c44919
App.DisplayName=Tears of the Kingdom Online Multiplayer Server
App.RootDir=./totk-online-multiplayer-server/
App.BaseDirectory=./totk-online-multiplayer-server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=java/bin/java
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--enable-native-access=ALL-UNNAMED -Dpolyglot.engine.WarnInterpreterOnly=false -Xms{{MinMemory}}M -Xmx{{MaxMemory}}M {{CustomJavaArgs}} -jar server.jar
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat={0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[totk-online-multiplayer-serverports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat=
App.UpdateSources=@IncludeJson[totk-online-multiplayer-serverupdates.json]
App.PreStartStages=@IncludeJson[totk-online-multiplayer-serverstart.json]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=True
App.SmartExcludeSupported=True
App.MonitorChildProcess=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessWaitMs=100
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=\\e\\[(\\d+;)*(\\d+)?[ABCDHJKfmsu]|\\e\\[?[?\\>\\=\\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=True
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
